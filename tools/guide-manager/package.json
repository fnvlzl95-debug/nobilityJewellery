{
  "name": "noblesse-guide-manager",
  "version": "1.0.0",
  "private": true,
  "description": "귀족 웹사이트 가이드 콘텐츠를 분석·생성·검수·반영하는 로컬 전용 도구",
  "main": "server/index.js",
  "scripts": {
    "start": "node --use-system-ca server/index.js",
    "dev": "concurrently \"node --use-system-ca server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "test": "node scripts/test-isolated.js",
    "test:models": "node scripts/evaluate-models.js",
    "test:image": "node scripts/smoke-image.js",
    "test:humanizer": "node scripts/smoke-humanizer.js",
    "verify": "npm test && npm run build"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^12.2.0",
    "csv-parse": "^6.1.0",
    "diff": "^8.0.2",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "parse5": "^8.0.1",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "robots-parser": "^3.0.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "vite": "^6.0.7"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
